<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="BGC\Checkout\Carts\Domain\Entity\Product">
      <field name="id"
             column="id"
             type="uuid"
             nullable="false"
             length="36"
      />
      <embedded name="description"
                class="BGC\Checkout\Shared\Domain\ValueObject\ProductDescription"
                column-prefix="product_"
      />
      <embedded name="price"
                class="BGC\Checkout\Shared\Domain\ValueObject\Price"
                column-prefix="price_"
      />
    </embeddable>
</doctrine-mapping>
