<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

  <entity name="BGC\Checkout\Carts\Domain\CartItem" table="cart_item">

    <id name="id" type="uuid" length="36"/>

    <embedded name="product"
              class="BGC\Checkout\Carts\Domain\Entity\Product"
              column-prefix="product_"
    />

    <embedded name="quantity"
              class="BGC\Checkout\Shared\Domain\ValueObject\Quantity"
              use-column-prefix="false"
    />

    <many-to-one field="cart"
                 target-entity="BGC\Checkout\Carts\Domain\Cart"
                 inversed-by="items">
      <join-column name="cart_id" referenced-column-name="id" nullable="false" />
    </many-to-one>

  </entity>

</doctrine-mapping>
