<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

  <mapped-superclass name="BGC\Checkout\Shared\Domain\AggregateRoot">

    <field name="createdAt" column="created_at" type="datetime_vo">
      <options>
        <option name="default">CURRENT_TIMESTAMP</option>
      </options>
    </field>

    <field name="updatedAt" column="updated_at" type="datetime_vo">
      <options>
        <option name="default">CURRENT_TIMESTAMP</option>
      </options>
    </field>

    <lifecycle-callbacks>
      <lifecycle-callback type="prePersist" method="refreshTimestamps"/>
      <lifecycle-callback type="preUpdate" method="refreshTimestamps"/>
    </lifecycle-callbacks>

  </mapped-superclass>

</doctrine-mapping>
